{
  "name": "@mynameisankit/react-json-renderer",
  "version": "1.1.0",
  "description": "A virtualized, expandable, and themeable JSON viewer for React.",
  "homepage": "https://mynameisankit.github.io/react-json-renderer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameisankit/react-json-renderer.git"
  },
  "keywords": [
    "react",
    "json",
    "json-viewer",
    "json-renderer",
    "virtualized",
    "storybook"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.15",
    "@storybook/addon-interactions": "8.6.15",
    "@storybook/addon-links": "8.6.15",
    "@storybook/blocks": "8.6.15",
    "@storybook/react": "8.6.15",
    "@storybook/react-vite": "8.6.15",
    "@storybook/test": "8.6.15",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react-swc": "3.5.0",
    "eslint": "8.56.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.5",
    "eslint-plugin-storybook": "0.6.15",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtualized-auto-sizer": "^1.0.24",
    "storybook": "8.6.15",
    "typescript": "5.2.2",
    "vite": "5.1.0"
  },
  "packageManager": "yarn@4.1.0",
  "dependencies": {
    "react-window": "1.8.10",
    "typescript-plugin-css-modules": "5.1.0"
  }
}
